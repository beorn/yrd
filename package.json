{
  "name": "git-yrd",
  "version": "0.0.1",
  "private": true,
  "description": "Agentic software delivery",
  "homepage": "https://yrd.dev",
  "license": "MIT",
  "author": "Bjørn Stabell <bjorn@stabell.org>",
  "repository": "github:beorn/yrd",
  "bin": {
    "git-yrd": "bin/git-yrd",
    "yrd": "bin/yrd"
  },
  "workspaces": [
    "packages/*"
  ],
  "files": [
    "ARCHITECTURE.md",
    "LICENSE",
    "README.md",
    "bin",
    "dist"
  ],
  "type": "module",
  "exports": {
    "./hab-projects": "./hab.projects.ts"
  },
  "scripts": {
    "yrd": "bun ./bin/yrd",
    "git-yrd": "bun ./bin/git-yrd",
    "build": "bun ./scripts/build.ts",
    "prepack": "bun run build",
    "test": "NODE_ENV=test BUN_RUNTIME_TRANSPILER_CACHE_PATH=\"${HOME}/.cache/silvercode/bun-transpiler-yrd-test\" bun --bun x vitest run",
    "test:slow": "NODE_ENV=test BUN_RUNTIME_TRANSPILER_CACHE_PATH=\"${HOME}/.cache/silvercode/bun-transpiler-yrd-test\" bun --bun x vitest run --config vitest.slow.config.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:hh": "bun scripts/typecheck-hh.ts",
    "check": "bun run typecheck && bun run test",
    "check:hh": "bun run typecheck:hh && bun run test",
    "fix": "oxlint --fix . && oxfmt --write ."
  },
  "dependencies": {
    "@silvery/ansi": "^0.25.0",
    "@silvery/commander": "^0.25.0",
    "@silvery/scope": "^0.25.0",
    "loggily": "github:beorn/loggily#f17cf656142e575bcc81eb19a496bae15439d9aa",
    "react": "^19.2.0",
    "silvery": "^0.25.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/react": "^19.2.0",
    "@yrd/queue-core": "workspace:*",
    "git-super": "^0.1.0",
    "typescript": "^6.0.3",
    "vitest": "4.1.10"
  },
  "overrides": {
    "git-super": "github:beorn/git-super#44366df27c43824f6640dd089cee6e5f63c6c507",
    "gitomic": "github:beorn/gitomic#5f763a6625c36047d76e09e311b39a871707873d",
    "loggily": "github:beorn/loggily#4fd5b54274d19734ca07f30eb68f673c1da96e3c"
  }
}
